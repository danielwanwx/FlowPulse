# Optional live GPT-5.6 mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Optional Langfuse mirror. Runtime remains authoritative without it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional direct project or trace URL shown in the cockpit.
LANGFUSE_TRACE_URL=

PORT=4310
# Local default stays loopback-only. Set HOST=0.0.0.0 only inside a container
# or behind an authenticated reverse proxy.
HOST=127.0.0.1

# Opt-in mutations for the disposable local Astronomy Shop runtime.
FLOWPULSE_DEVELOPMENT_ENABLED=0
FLOWPULSE_OTLP_DIR=./outputs/live/otel
# Host directory mounted read-only into the control-plane worker at
# /flowpulse-otel. Override this when Astronomy Shop writes OTel captures in a
# different checkout/worktree; keep machine-specific absolute paths in .env.
FLOWPULSE_OTEL_HOST_DIR=../outputs/live/otel
# Optional; otherwise FlowPulse discovers the published flagd-ui port from Docker.
FLOWPULSE_FLAGD_UI_URL=

# Signed worker -> local Node bridge for guided Codex/preflight/action work.
# Keep this unset outside the disposable local development runtime.
FLOWPULSE_V3_INTERNAL_BRIDGE_URL=http://host.docker.internal:4310
FLOWPULSE_V3_INTERNAL_BRIDGE_HMAC_SECRET=
# Independent safe-compensation port. It only permits recreating Checkout
# while paymentUnreachable is already off; it can never re-enable the fault.
FLOWPULSE_V3_SAFE_ROLLBACK_URL=http://host.docker.internal:4310
FLOWPULSE_V3_SAFE_ROLLBACK_HMAC_SECRET=
